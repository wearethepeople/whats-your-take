# Local development — copy to .env (gitignored). Production values are Fly
# secrets; see docs/deploy.md.

# SQLite database file. Defaults to ./data/sqlite.db when unset.
DATABASE_PATH=./data/sqlite.db

# Host-console auth (both required; no dev fallback).
# Generate each with: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=

# Litestream / Tigris — set by `fly storage create` in production. Not
# needed for local dev unless you're testing event photo upload (host
# console's Photos page), which reads/writes the same bucket:
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=

# Emma (newsletter signup, footer form). All three required for the
# signup to work; omit locally to leave it non-functional.
# EMMA_ACCOUNT_ID=
# EMMA_PUBLIC_KEY=
# EMMA_PRIVATE_KEY=
